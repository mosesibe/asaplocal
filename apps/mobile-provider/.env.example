# Local dev only — expo start reads .env.local automatically (gitignored).
# EAS builds get these from eas.json's per-profile "env" block instead.

EXPO_PUBLIC_API_URL="http://localhost:3001"

# ── Google Sign-In ──────────────────────────────────────────
# Web OAuth client (Google Cloud Console) — same value as apps/provider's
# GOOGLE_CLIENT_ID. The backend verifies the native idToken's audience
# against this, not against a mobile-specific client id.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=""
# iOS OAuth client created for bundle id pro.asaplocal.provider — only
# needed so the native picker can present itself on iOS. Its reversed form
# also goes into app.json's google-signin plugin "iosUrlScheme".
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=""

# ── Sign in with Apple ─────────────────────────────────────
# No client-side env var needed — expo-apple-authentication uses the app's
# own bundle id + the "Sign In with Apple" entitlement (added automatically
# by its config plugin, see app.json). Server-side verification checks the
# token's audience against "pro.asaplocal.provider" directly (see
# apps/provider/app/api/mobile/auth/apple/route.ts).
