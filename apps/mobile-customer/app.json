{
  "expo": {
    "name": "AsapLocal",
    "slug": "asaplocal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "asaplocal",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "pro.asaplocal.customer",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "pro.asaplocal.customer",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.ACCESS_COARSE_LOCATION", "android.permission.ACCESS_FINE_LOCATION"],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCF7kEAMVNV8hEs4SUtwegCxVHsycqMmtg"
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#090e1a",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "AsapLocal uses your photos to attach pictures of the space or job to your requests.",
          "cameraPermission": "AsapLocal uses your camera so you can take a photo directly to attach to your request."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AsapLocal uses your location to find local pros and fill in your address."
        }
      ],
      [
        "react-native-maps",
        {
          "iosGoogleMapsApiKey": "AIzaSyCigTdR363LL5JG0I8cgY8yDXndQsgmDhA"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "89931eff-8f41-4b2a-a036-c5297d9758b3"
      }
    },
    "owner": "asaplocal",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/89931eff-8f41-4b2a-a036-c5297d9758b3"
    }
  }
}
