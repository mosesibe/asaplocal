// ─────────────────────────────────────────────────────────────────────────
// AsapLocal — Prisma Schema
// PostgreSQL (Supabase) · pgcrypto for UUIDs · designed for RBAC + lead
// marketplace + dispatcher approval workflow.
// ─────────────────────────────────────────────────────────────────────────

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ───────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  PROVIDER
  DISPATCHER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
  PENDING_VERIFICATION
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
  MORE_INFO_REQUESTED
}

enum BusinessType {
  SOLE_TRADER
  LIMITED_COMPANY
  PARTNERSHIP
  SELF_EMPLOYED
  CHARITY
}

enum IdentityDocType {
  PASSPORT
  DRIVING_LICENCE
  NATIONAL_ID
}

enum TrustTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum InsuranceType {
  PUBLIC_LIABILITY
  PROFESSIONAL_INDEMNITY
  EMPLOYERS_LIABILITY
}

enum VerificationDocType {
  UTILITY_BILL
  BUSINESS_BANK_STATEMENT
  HMRC_CORRESPONDENCE
  PUBLIC_LIABILITY_INSURANCE
  OTHER
}

enum ReferenceStatus {
  REQUESTED
  VERIFIED
  EXPIRED
}

enum SubscriptionPlan {
  FREE
  PRO
  PREMIUM
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
  UNPAID
}

enum PriceType {
  FIXED
  HOURLY
  QUOTE_ONLY
}

enum JobRequestStatus {
  OPEN // just posted, being matched to providers
  MATCHING // leads distributed to eligible providers
  QUOTED // at least one quote received
  ASSIGNED // customer accepted a quote / booked a provider
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

enum LeadStatus {
  AVAILABLE // still open for purchase/claim by more providers
  LIMITED // sold to max providers, no longer purchasable
  EXPIRED
  CLOSED // job request cancelled/completed upstream
}

enum LeadAcquisitionType {
  PURCHASE // paid per-lead via card
  SUBSCRIPTION_ALLOWANCE // consumed from monthly plan allowance
  CREDIT // consumed from purchased lead-credit wallet
  CLAIM // free claim (e.g. promo / first-come within radius)
}

enum ProviderLeadStatus {
  NEW
  CONTACTED
  QUOTED
  WON
  LOST
}

enum RefundRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RefundReason {
  OUT_OF_SERVICE_AREA
  DUPLICATE_LEAD
  SPAM_OR_FAKE
  UNRESPONSIVE_CUSTOMER
  WRONG_CATEGORY
  OTHER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  AWAITING_APPROVAL
  COMPLETED
  CANCELLED
  DISPUTED
}

enum DisputeStatus {
  OPEN
  RESOLVED
}

enum PayoutMethod {
  STRIPE_CONNECT // automatic transfer to the provider's connected account
  MANUAL // bank transfer done by hand and recorded by an admin
}

enum VariationStatus {
  PENDING // proposed by the provider, awaiting the customer's decision
  ACCEPTED
  REJECTED
}

enum QuoteStatus {
  PENDING
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

enum PaymentType {
  BOOKING_DEPOSIT
  BOOKING_FULL
  BOOKING_BALANCE // remaining amount after the deposit, incl. accepted variations
  LEAD_PURCHASE
  LEAD_CREDIT_TOPUP
  SUBSCRIPTION
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  FLAGGED
  HIDDEN
}

enum ReportTargetType {
  LISTING
  REVIEW
  USER
  MESSAGE
  BOOKING
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum NotificationType {
  NEW_LEAD
  LEAD_CLAIMED
  QUOTE_RECEIVED
  QUOTE_ACCEPTED
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  MESSAGE_RECEIVED
  REVIEW_RECEIVED
  PAYMENT_RECEIVED
  REFUND_PROCESSED
  SUBSCRIPTION_RENEWED
  VERIFICATION_UPDATE
  DISPATCHER_ASSIGNMENT
  APPROVAL_DECISION
  SYSTEM
  STAFF_STATUS_UPDATE
  STAFF_ASSIGNED
  BOOKING_AWAITING_APPROVAL
  BOOKING_COMPLETED
  PROVIDER_ON_THE_WAY
  VARIATION_PROPOSED
  VARIATION_DECIDED
  BOOKING_DISPUTED
  DISPUTE_RESOLVED
}

enum ApprovalActionType {
  JOB_CREATE
  JOB_UPDATE
  JOB_DELETE
  JOB_ASSIGN_PROVIDER
  JOB_STATUS_OVERRIDE
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AccountDeletionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model AccountDeletionRequest {
  id           String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String                       @db.Uuid
  reason       String?                      @db.Text
  status       AccountDeletionRequestStatus @default(PENDING)
  reviewedById String?                      @db.Uuid
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime                     @default(now())

  user       User  @relation("AccountDeletionRequester", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("AccountDeletionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
}

// ── Core identity ───────────────────────────────────────────────────────

model User {
  id                     String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                  String     @unique
  emailVerified          DateTime?
  name                   String? // populated by OAuth providers (e.g. Google); not used for display — see Profile.firstName/lastName
  phone                  String?    @unique
  passwordHash           String? // null when using OAuth-only
  role                   Role       @default(CUSTOMER)
  status                 UserStatus @default(PENDING_VERIFICATION)
  image                  String?
  phoneVerifiedAt        DateTime?
  // Set the moment an account starts (or gains) provider access — at fresh
  // provider signup, or when an existing customer confirms their password to
  // add a business. Independent of `role` (which stays CUSTOMER for a merged
  // account, see Business relation below) and of `business` (not created
  // until onboarding completes) — this is what lets the provider app's
  // middleware admit the user before either of those is otherwise true.
  providerSince          DateTime?
  // Set at registration when the required Terms & Privacy Policy checkbox
  // is accepted. termsVersion records which version of the terms they saw.
  termsAcceptedAt        DateTime?
  termsVersion           String?
  // Marketing consent is deliberately separate from termsAcceptedAt: bundling
  // the two would make the marketing consent invalid (it must be freely given
  // and specific, not a condition of signing up). The timestamp + source
  // record *when and where* it was given, which a bare boolean can't evidence.
  marketingEmail         Boolean    @default(false)
  marketingSms           Boolean    @default(false)
  marketingConsentAt     DateTime?
  marketingConsentSource String?
  // Lets an unsubscribe link work without a login, and be revoked by rotating.
  unsubscribeToken       String?    @unique
  referralCode           String?    @unique
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  lastLoginAt            DateTime?
  suspendedAt            DateTime?
  suspendedReason        String?

  profile                  Profile?
  business                 Business? // present once onboarding completes; role stays CUSTOMER for accounts that added a business on top of an existing customer account — see providerSince
  jobRequests              JobRequest[]              @relation("CustomerJobRequests")
  favourites               Favourite[]
  reviewsWritten           Review[]                  @relation("ReviewAuthor")
  bookingsAsCustomer       Booking[]                 @relation("CustomerBookings")
  payments                 Payment[]
  notifications            Notification[]
  pushSubscriptions        PushSubscription[]
  sentMessages             Message[]                 @relation("MessageSender")
  conversations            ConversationParticipant[]
  reportsFiled             Report[]                  @relation("ReportsFiled")
  auditLogs                AuditLog[]                @relation("AuditActor")
  approvalRequestsMade     ApprovalRequest[]         @relation("ApprovalRequester")
  approvalRequestsReviewed ApprovalRequest[]         @relation("ApprovalReviewer")
  dispatcherAssignments    DispatcherAssignment[]    @relation("DispatcherActor")
  accounts                 Account[]
  sessions                 Session[]
  addresses                Address[]
  authenticators           Authenticator[]
  phoneVerificationCodes   PhoneVerificationCode[]
  passwordResetTokens      PasswordResetToken[]
  referralsSent            Referral[]                @relation("Referrer")
  referralReceived         Referral?                 @relation("Referee")
  accountCredits           AccountCredit[]
  deletionRequestsMade     AccountDeletionRequest[]  @relation("AccountDeletionRequester")
  deletionRequestsReviewed AccountDeletionRequest[]  @relation("AccountDeletionReviewer")
  payoutsRecorded          Payout[]                  @relation("PayoutRecorder")
  staffMemberReviews       StaffMember[]             @relation("StaffMemberReviewer")
  disputesRaised           BookingDispute[]          @relation("DisputesRaised")

  @@index([role])
  @@index([status])
  @@index([email])
}

// Auth.js WebAuthn (passkey) credential storage — shape required by the
// Prisma adapter's WebAuthn support. providerAccountId mirrors userId for
// the "webauthn" provider (no separate external account id).
model Authenticator {
  credentialID         String  @unique
  userId               String  @db.Uuid
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

// Short-lived OTP codes for "Verify phone" in the account Security section.
model PhoneVerificationCode {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  phone     String
  code      String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Single-use, short-lived token for the forgot-password email link. Kept
// separate from VerificationToken (used for email-verify links) so a token
// minted for one flow can never be replayed against the other.
model PasswordResetToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum ReferralStatus {
  PENDING
  COMPLETED
}

// referrerId shared a code; refereeId signed up using it. Rewarded (both
// sides credited via AccountCredit) once the referee's first payment succeeds.
model Referral {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referrerId  String         @db.Uuid
  refereeId   String         @unique @db.Uuid
  code        String
  status      ReferralStatus @default(PENDING)
  rewardPence Int            @default(1000)
  createdAt   DateTime       @default(now())
  completedAt DateTime?

  referrer User @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User @relation("Referee", fields: [refereeId], references: [id], onDelete: Cascade)

  @@index([referrerId])
}

enum AccountCreditReason {
  REFERRAL_REWARD
}

// Ledger of account-credit grants; balance = sum(amountPence) for a user.
// Redemption at checkout is a separate, not-yet-built feature.
model AccountCredit {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String              @db.Uuid
  amountPence Int
  reason      AccountCreditReason
  referralId  String?             @db.Uuid
  createdAt   DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Auth.js adapter tables
model Account {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @unique @db.Uuid
  firstName   String
  lastName    String
  avatarUrl   String?
  bio         String?  @db.Text
  addressLine String?
  city        String?
  postcode    String?
  country     String   @default("GB")
  lat         Decimal? @db.Decimal(9, 6)
  lng         Decimal? @db.Decimal(9, 6)
  timezone    String   @default("Europe/London")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([city])
}

// Saved service-location addresses for a customer, reused across job posts
// via the "saved address" option in the job-posting location picker. Distinct
// from Profile's home address — a customer may post jobs for several sites.
model Address {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @db.Uuid
  addressLine String
  city        String
  postcode    String?
  country     String   @default("GB")
  lat         Decimal  @db.Decimal(9, 6)
  lng         Decimal  @db.Decimal(9, 6)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Categories & Businesses ─────────────────────────────────────────────

model Category {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                    String   @unique
  slug                    String   @unique
  icon                    String?
  description             String?  @db.Text
  parentId                String?  @db.Uuid
  isActive                Boolean  @default(true)
  isFeatured              Boolean  @default(false)
  isEmergency             Boolean  @default(false)
  sortOrder               Int      @default(0)
  createdAt               DateTime @default(now())
  // Regulated-trade guidance shown on the qualifications verification step
  // (e.g. Electrician -> ["NICEIC","NAPIT","ECA"]). Advisory only — not
  // enforced; Qualification.name stays free text.
  isRegulatedTrade        Boolean  @default(false)
  suggestedQualifications String[] @default([])

  parent         Category?       @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children       Category[]      @relation("CategoryChildren")
  services       Service[]
  jobRequests    JobRequest[]
  qualifications Qualification[]
  portfolioItems PortfolioItem[]

  @@index([parentId])
  @@index([slug])
}

model Business {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId             String             @unique @db.Uuid
  name                String
  slug                String             @unique
  description         String?            @db.Text
  logoUrl             String?
  coverImageUrl       String?
  phone               String?
  email               String?
  website             String?
  verificationStatus  VerificationStatus @default(UNVERIFIED)
  verifiedAt          DateTime?
  verificationDocsUrl String[]
  addressLine         String?
  city                String
  postcode            String?
  country             String             @default("GB")
  lat                 Decimal            @db.Decimal(9, 6)
  lng                 Decimal            @db.Decimal(9, 6)
  baseRadiusMiles     Int                @default(10)
  yearsInBusiness     Int?
  employeeCount       Int?
  insured             Boolean            @default(false)
  avgRating           Decimal            @default(0) @db.Decimal(2, 1)
  reviewCount         Int                @default(0)
  completedJobsCount  Int                @default(0)
  responseRatePct     Decimal            @default(0) @db.Decimal(5, 2)
  avgResponseMins     Int?
  profileViews        Int                @default(0)
  isFeatured          Boolean            @default(false)
  featuredUntil       DateTime?
  stripeAccountId     String? // Stripe Connect (payouts)
  stripeCustomerId    String? // Stripe Customer (billing)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  // ── Phase 2: Business Information ──────────────────────────────────────
  businessType              BusinessType?
  tradingName               String?
  companyRegistrationNumber String?
  companyDirectorName       String? // self-reported; matched against Companies House officers in Phase 4
  utrNumber                 String?
  vatNumber                 String?
  businessInfoCompletedAt   DateTime?

  // ── Phase 4: Business Verification (Companies House auto-check) ───────
  // Overall pass/fail for this phase reuses verificationStatus/verifiedAt
  // above — both the Ltd auto-check and the sole-trader manual-document
  // path drive that same field, so there's no duplicate status column here.
  companiesHouseSnapshot      Json?
  companiesHouseCheckedAt     DateTime?
  companiesHouseDirectorMatch Boolean?

  // ── Phase 9: Banking (Stripe Connect) ──────────────────────────────────
  payoutsEnabled           Boolean   @default(false)
  stripeConnectOnboardedAt DateTime?

  // ── Phase 10: Profile Creation ─────────────────────────────────────────
  photoUrls                  String[]
  languagesSpoken            String[]
  emergencyCalloutsAvailable Boolean   @default(false)
  workingHours               Json? // { mon: {open,close}, tue: {...}, ... }
  targetResponseMins         Int? // self-declared target, distinct from computed avgResponseMins
  profileCompletedAt         DateTime?

  // ── Trust tier (computed — see packages/core/src/trust-tier.ts) ───────
  trustTier          TrustTier @default(BRONZE)
  trustTierUpdatedAt DateTime?
  platinumOverride   Boolean   @default(false) // admin-settable manual Platinum promotion

  owner                 User                           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  serviceAreas          ServiceArea[]
  services              Service[]
  subscription          Subscription?
  leadCreditWallet      LeadCreditWallet?
  leadAccesses          LeadAccess[]
  quotes                Quote[]
  bookings              Booking[]                      @relation("ProviderBookings")
  reviews               Review[]
  favouritedBy          Favourite[]
  payments              Payment[]
  dispatcherAssignments DispatcherAssignment[]         @relation("AssignedBusiness")
  identityVerification  IdentityVerification?
  verificationDocuments BusinessVerificationDocument[]
  staffMembers          StaffMember[]
  qualifications        Qualification[]
  insurancePolicies     InsurancePolicy[]
  portfolioItems        PortfolioItem[]
  references            BusinessReference[]
  payouts               Payout[]
  addresses             BusinessAddress[]
  supplies              Supply[]

  @@index([city])
  @@index([verificationStatus])
  @@index([isFeatured])
  @@index([lat, lng])
  @@index([trustTier])
}

// Additional trading addresses for a business. The primary address stays
// inline on Business (it's what lead matching geocodes against); this table
// is for multi-site operators — limited companies, partnerships and charities
// with more than one branch. Sole traders normally have none.
model BusinessAddress {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId  String   @db.Uuid
  label       String? // e.g. "Head office", "Leeds branch"
  addressLine String
  city        String
  postcode    String?
  country     String   @default("GB")
  lat         Decimal? @db.Decimal(9, 6)
  lng         Decimal? @db.Decimal(9, 6)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([city])
}

// Products a provider sells alongside their services (e.g. a plumber listing
// taps and valves). Display-only for now — surfaced on the public listing,
// not orderable through the platform.
model Supply {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId  String   @db.Uuid
  name        String
  description String?  @db.Text
  pricePence  Int?
  unit        String? // e.g. "per metre", "each", "per box"
  imageUrl    String?
  inStock     Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

// Admin-recorded ledger of payouts made to providers outside Stripe Connect
// (e.g. manual bank transfer) — there's no automated Stripe Transfer sync
// yet, so this is how the platform tracks what's actually been paid out.
// Money actually sent to a provider. A row here means funds moved — the
// amount *owed* lives on Booking.providerNetPence, so an unpaid entitlement
// is never mistaken for a completed payout.
model Payout {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId       String       @db.Uuid
  bookingId        String?      @db.Uuid // the job being settled; null for ad-hoc/bulk manual payouts
  amountPence      Int // net paid to the provider
  platformFeePence Int          @default(0) // commission retained on this settlement
  method           PayoutMethod @default(MANUAL)
  stripeTransferId String?      @unique // set for STRIPE_CONNECT transfers
  reference        String?
  paidAt           DateTime     @default(now())
  createdById      String?      @db.Uuid // null for automatic transfers — no admin actor
  createdAt        DateTime     @default(now())

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("PayoutRecorder", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([bookingId])
}

model IdentityVerification {
  id                          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId                  String             @unique @db.Uuid
  docType                     IdentityDocType?
  stripeVerificationSessionId String?            @unique
  status                      VerificationStatus @default(UNVERIFIED)
  verifiedAt                  DateTime?
  lastError                   String?
  // Extracted from Stripe's verified_outputs once VERIFIED — used to
  // cross-check against the self-reported Companies House director name.
  extractedFullName           String?
  reviewNote                  String?
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([status])
}

model BusinessVerificationDocument {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String              @db.Uuid
  docType    VerificationDocType
  fileUrl    String
  uploadedAt DateTime            @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

// Company-side field staff (e.g. a Limited Company's employees) that get
// dispatched to bookings. Sole traders / self-employed providers don't use
// this — see packages/core/src/business-type.ts#canHaveStaff. Records only,
// no login/auth account — managed by the business owner, approved by Admin.
model StaffMember {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId      String             @db.Uuid
  fullName        String
  jobTitle        String?
  phone           String
  email           String?
  profilePhotoUrl String
  idFrontImageUrl String
  idBackImageUrl  String
  approvalStatus  VerificationStatus @default(PENDING)
  reviewNote      String?
  isActive        Boolean            @default(true)
  submittedAt     DateTime           @default(now())
  reviewedAt      DateTime?
  reviewedById    String?            @db.Uuid
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reviewedBy User?     @relation("StaffMemberReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  bookings   Booking[] @relation("AssignedStaff")

  @@index([businessId])
  @@index([approvalStatus])
}

model Qualification {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId        String             @db.Uuid
  categoryId        String?            @db.Uuid
  name              String // e.g. "NICEIC", "Gas Safe Register", "NVQ Level 2 Beauty Therapy"
  issuingBody       String?
  certificateNumber String?
  expiryDate        DateTime?
  documentUrl       String?
  status            VerificationStatus @default(UNVERIFIED)
  verifiedAt        DateTime?
  reviewNote        String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([status])
}

model InsurancePolicy {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId           String             @db.Uuid
  type                 InsuranceType
  provider             String
  policyNumber         String
  expiryDate           DateTime
  coverageAmountPence  Int
  documentUrl          String
  status               VerificationStatus @default(UNVERIFIED)
  verifiedAt           DateTime?
  reviewNote           String?
  expiryReminderSentAt DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, type])
  @@index([status])
  @@index([expiryDate])
}

model PortfolioItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId  String   @db.Uuid
  categoryId  String?  @db.Uuid
  title       String?
  description String?  @db.Text
  beforeUrl   String?
  afterUrl    String?
  videoUrl    String?
  photoUrls   String[]
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([businessId])
}

model BusinessReference {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId        String          @db.Uuid
  refereeName       String
  refereeEmail      String
  relationshipNote  String?
  verificationToken String          @unique
  status            ReferenceStatus @default(REQUESTED)
  testimonial       String?         @db.Text
  requestedAt       DateTime        @default(now())
  verifiedAt        DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model ServiceArea {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId     String   @db.Uuid
  city           String
  postcodePrefix String?
  lat            Decimal  @db.Decimal(9, 6)
  lng            Decimal  @db.Decimal(9, 6)
  radiusMiles    Int      @default(10)
  createdAt      DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([lat, lng])
}

model Service {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId              String    @db.Uuid
  categoryId              String    @db.Uuid
  title                   String
  description             String?   @db.Text
  priceType               PriceType @default(QUOTE_ONLY)
  priceMinPence           Int?
  priceMaxPence           Int?
  durationMins            Int?
  // AI's estimate of how long this job typically takes, shown to the provider
  // as guidance on the services page. Kept separate from `durationMins` (the
  // provider's own figure) so a suggestion never silently overwrites their input.
  aiSuggestedDurationMins Int?
  images                  String[]
  // Providers pause a service they no longer offer — paused services stop
  // matching leads (see findEligibleProviders / getLeadsNearBusiness) but the
  // row is kept so pricing and history survive un-pausing.
  isActive                Boolean   @default(true)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  bookings Booking[]

  @@index([businessId])
  @@index([categoryId])
}

// ── Job requests & the lead marketplace ─────────────────────────────────
// Customer posts a JobRequest with no provider chosen. The platform fans it
// out as a Lead to eligible providers (category + radius). Providers acquire
// access via LeadAccess (purchase / subscription allowance / credit / claim)
// and track their own pipeline status independently of other providers.

model JobRequest {
  id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId            String           @db.Uuid
  categoryId            String           @db.Uuid
  title                 String
  description           String           @db.Text
  photos                String[]
  budgetMinPence        Int?
  budgetMaxPence        Int?
  preferredDate         DateTime?
  flexibleDate          Boolean          @default(true)
  addressLine           String?
  city                  String
  postcode              String?
  lat                   Decimal          @db.Decimal(9, 6)
  lng                   Decimal          @db.Decimal(9, 6)
  status                JobRequestStatus @default(OPEN)
  aiSuggestedCategoryId String?          @db.Uuid
  aiCategoryConfidence  Decimal?         @db.Decimal(4, 3)
  maxLeadSales          Int              @default(5) // cap on how many providers can acquire this lead
  leadPricePence        Int              @default(1000) // computed at creation (£5–£20 band)
  expiresAt             DateTime
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  customer              User                   @relation("CustomerJobRequests", fields: [customerId], references: [id], onDelete: Cascade)
  category              Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  lead                  Lead?
  quotes                Quote[]
  booking               Booking?
  conversations         Conversation[]
  dispatcherAssignments DispatcherAssignment[]
  approvalRequests      ApprovalRequest[]

  @@index([customerId])
  @@index([categoryId])
  @@index([status])
  @@index([city])
  @@index([lat, lng])
}

model Lead {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobRequestId String     @unique @db.Uuid
  status       LeadStatus @default(AVAILABLE)
  radiusMiles  Int        @default(15)
  salesCount   Int        @default(0)
  viewCount    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  jobRequest JobRequest   @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  accesses   LeadAccess[]

  @@index([status])
}

// One row per provider who has acquired (purchased/claimed) a given lead.
model LeadAccess {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId          String              @db.Uuid
  businessId      String              @db.Uuid
  acquisitionType LeadAcquisitionType
  pricePaidPence  Int                 @default(0)
  creditsSpent    Int                 @default(0)
  status          ProviderLeadStatus  @default(NEW)
  contactedAt     DateTime?
  quotedAt        DateTime?
  wonAt           DateTime?
  lostAt          DateTime?
  lostReason      String?
  isRefunded      Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  lead              Lead                   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  business          Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payment           Payment?
  refundRequest     RefundRequest?
  creditTransaction LeadCreditTransaction?

  @@unique([leadId, businessId]) // a provider can only acquire a given lead once
  @@index([businessId, status])
  @@index([leadId])
}

model RefundRequest {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadAccessId      String              @unique @db.Uuid
  requestedById     String              @db.Uuid
  reason            RefundReason
  details           String?             @db.Text
  status            RefundRequestStatus @default(PENDING)
  refundAmountPence Int?
  reviewedById      String?             @db.Uuid
  reviewedAt        DateTime?
  reviewNote        String?
  createdAt         DateTime            @default(now())

  leadAccess LeadAccess @relation(fields: [leadAccessId], references: [id], onDelete: Cascade)

  @@index([status])
}

model LeadCreditWallet {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String   @unique @db.Uuid
  balance    Int      @default(0)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  business     Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  transactions LeadCreditTransaction[]
}

enum LeadCreditTxType {
  SUBSCRIPTION_GRANT
  TOPUP_PURCHASE
  SPEND
  REFUND
  ADMIN_ADJUSTMENT
}

model LeadCreditTransaction {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  walletId     String           @db.Uuid
  type         LeadCreditTxType
  amount       Int // positive = credit, negative = debit
  leadAccessId String?          @unique @db.Uuid
  description  String?
  createdAt    DateTime         @default(now())

  wallet     LeadCreditWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  leadAccess LeadAccess?      @relation(fields: [leadAccessId], references: [id], onDelete: SetNull)

  @@index([walletId])
}

// ── Quotes & Bookings ────────────────────────────────────────────────────

model Quote {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobRequestId String      @db.Uuid
  businessId   String      @db.Uuid
  amountPence  Int
  message      String?     @db.Text
  validUntil   DateTime?
  status       QuoteStatus @default(SENT)
  aiGenerated  Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  jobRequest JobRequest @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  booking    Booking?

  @@unique([jobRequestId, businessId])
  @@index([status])
}

model Booking {
  id                        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId                String        @db.Uuid
  businessId                String        @db.Uuid
  serviceId                 String?       @db.Uuid
  jobRequestId              String?       @unique @db.Uuid
  quoteId                   String?       @unique @db.Uuid
  scheduledDate             DateTime
  status                    BookingStatus @default(PENDING)
  totalAmountPence          Int
  depositAmountPence        Int?
  addressLine               String
  city                      String
  postcode                  String?
  notes                     String?       @db.Text
  cancelledReason           String?
  cancelledAt               DateTime?
  startedAt                 DateTime?
  completedAt               DateTime?
  durationMinutes           Int?
  assignedStaffId           String?       @db.Uuid
  assignedAt                DateTime?
  etaMinutes                Int?
  // Provider settlement, computed once the job is complete and paid in full.
  platformFeePence          Int?
  providerNetPence          Int?
  settledAt                 DateTime?
  trackingEnabled           Boolean       @default(true)
  providerLat               Decimal?      @db.Decimal(9, 6)
  providerLng               Decimal?      @db.Decimal(9, 6)
  providerLocationUpdatedAt DateTime?
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  customer        User               @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Cascade)
  business        Business           @relation("ProviderBookings", fields: [businessId], references: [id], onDelete: Cascade)
  service         Service?           @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  jobRequest      JobRequest?        @relation(fields: [jobRequestId], references: [id], onDelete: SetNull)
  quote           Quote?             @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  assignedStaff   StaffMember?       @relation("AssignedStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  payments        Payment[]
  review          Review?
  conversation    Conversation?
  jobSheetEntries JobSheetEntry[]
  variations      BookingVariation[]
  payouts         Payout[]
  disputes        BookingDispute[]

  @@index([customerId])
  @@index([assignedStaffId])
  @@index([businessId])
  @@index([status])
  @@index([scheduledDate])
}

// Raised by the customer when they don't accept a job the provider marked
// done (Booking.status AWAITING_APPROVAL → DISPUTED). The provider responds
// — with photos of any further work — and marks it resolved, which returns
// the booking to AWAITING_APPROVAL so the customer reconfirms through the
// same accept-completion gate as before. A booking can cycle through this
// more than once, so disputes are a list, not a single row on Booking.
model BookingDispute {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId        String        @db.Uuid
  raisedById       String        @db.Uuid
  reason           String        @db.Text
  photos           String[]
  status           DisputeStatus @default(OPEN)
  providerResponse String?       @db.Text
  providerPhotos   String[]
  resolvedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  raisedBy User    @relation("DisputesRaised", fields: [raisedById], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status])
}

// A running log of what the provider actually did during a booking — added
// to while Booking.status is IN_PROGRESS, shown to the customer as part of
// the "who did what" record before they accept completion.
model JobSheetEntry {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId   String   @db.Uuid
  description String   @db.Text
  photos      String[] // provider's photos of the work done, shown to the customer
  loggedAt    DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

// Extra work agreed on site after the quote was accepted. Kept separate from
// Booking.totalAmountPence so the original agreement is never rewritten, and
// separate from JobSheetEntry because a variation is a commercial proposal the
// customer must consent to — not a factual record of work already done.
model BookingVariation {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId   String          @db.Uuid
  description String          @db.Text
  amountPence Int
  photos      String[]
  status      VariationStatus @default(PENDING)
  decidedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, status])
}

// ── Reviews & Favourites ─────────────────────────────────────────────────

model Review {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId        String       @unique @db.Uuid
  authorId         String       @db.Uuid
  businessId       String       @db.Uuid
  rating           Int // 1-5
  comment          String?      @db.Text
  photos           String[]
  status           ReviewStatus @default(PUBLISHED)
  aiFlagged        Boolean      @default(false)
  aiFlagReason     String?
  providerResponse String?      @db.Text
  respondedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  author   User     @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reports  Report[]

  @@index([businessId, status])
  @@index([rating])
}

model Favourite {
  customerId String   @db.Uuid
  businessId String   @db.Uuid
  createdAt  DateTime @default(now())

  customer User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([customerId, businessId])
  @@index([businessId])
}

// ── Messaging ─────────────────────────────────────────────────────────────

model Conversation {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobRequestId  String?   @db.Uuid
  bookingId     String?   @unique @db.Uuid
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())

  jobRequest   JobRequest?               @relation(fields: [jobRequestId], references: [id], onDelete: SetNull)
  booking      Booking?                  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([jobRequestId])
}

model ConversationParticipant {
  conversationId String    @db.Uuid
  userId         String    @db.Uuid
  lastReadAt     DateTime?
  joinedAt       DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String   @db.Uuid
  senderId       String   @db.Uuid
  body           String   @db.Text
  attachments    String[]
  readByUserIds  String[] @db.Uuid
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ── Payments & Subscriptions ─────────────────────────────────────────────

model Payment {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String        @db.Uuid
  businessId            String?       @db.Uuid
  bookingId             String?       @db.Uuid
  leadAccessId          String?       @unique @db.Uuid
  type                  PaymentType
  status                PaymentStatus @default(PENDING)
  amountPence           Int
  currency              String        @default("gbp")
  refundedAmountPence   Int           @default(0)
  stripePaymentIntentId String?       @unique
  stripeChargeId        String?
  stripeInvoiceId       String?
  failureReason         String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business?   @relation(fields: [businessId], references: [id], onDelete: SetNull)
  booking    Booking?    @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  leadAccess LeadAccess? @relation(fields: [leadAccessId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([businessId])
  @@index([status])
  @@index([type])
}

model Subscription {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId           String             @unique @db.Uuid
  plan                 SubscriptionPlan   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  monthlyLeadAllowance Int                @default(0)
  leadAllowanceUsed    Int                @default(0)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([plan])
  @@index([status])
}

// ── Notifications, Reports, Audit, Dispatcher approvals ──────────────────

model Notification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  body      String?
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model PushSubscription {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Report {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId     String           @db.Uuid
  targetType     ReportTargetType
  targetId       String           @db.Uuid
  reviewTarget   String?          @db.Uuid // convenience FK when targetType = REVIEW
  reason         String
  details        String?          @db.Text
  status         ReportStatus     @default(OPEN)
  resolvedById   String?          @db.Uuid
  resolvedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime         @default(now())

  reporter       User    @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewedReview Review? @relation(fields: [reviewTarget], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([targetType, targetId])
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @db.Uuid
  actorRole  Role?
  action     String // e.g. "user.suspend", "lead.refund.approve"
  targetType String
  targetId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// Dispatchers can act on job requests (assign to a provider, update, delete)
// but every mutating action is recorded as an ApprovalRequest that an Admin
// must approve before it takes effect (except read-only tracking/assignment
// proposals, which is why `payload` stores the *proposed* change).
model ApprovalRequest {
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestedById String                @db.Uuid
  actionType    ApprovalActionType
  jobRequestId  String?               @db.Uuid
  payload       Json // proposed change, e.g. { assignBusinessId, note }
  status        ApprovalRequestStatus @default(PENDING)
  reviewedById  String?               @db.Uuid
  reviewedAt    DateTime?
  reviewNote    String?
  createdAt     DateTime              @default(now())

  requestedBy User        @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy  User?       @relation("ApprovalReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  jobRequest  JobRequest? @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([requestedById])
}

// Confirmed record of a dispatcher sending a job to a specific provider
// (created once the corresponding ApprovalRequest is APPROVED).
model DispatcherAssignment {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobRequestId       String   @db.Uuid
  dispatcherId       String   @db.Uuid
  assignedBusinessId String   @db.Uuid
  note               String?
  approvalRequestId  String?  @unique @db.Uuid
  createdAt          DateTime @default(now())

  jobRequest       JobRequest @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  dispatcher       User       @relation("DispatcherActor", fields: [dispatcherId], references: [id], onDelete: Cascade)
  assignedBusiness Business   @relation("AssignedBusiness", fields: [assignedBusinessId], references: [id], onDelete: Cascade)

  @@index([jobRequestId])
  @@index([dispatcherId])
}
